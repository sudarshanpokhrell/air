Hide.*

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Env & secrets
.env
.env.*
!.env.example
keys/
*.pem
!example-app/certs/certificate.pem
*.p8
*.p12
*.jks
*.keystore

# Node (cli/)
node_modules/
cli/dist/

# Go (server/)
server/bin/
server/tmp/
*.test
*.out
coverage.*

# Expo export output
dist/

# Dashboard build output is ignored, except the placeholder that keeps
# go:embed compiling on a fresh clone (copied from web/public on every build).
!server/web/dist/
server/web/dist/*
!server/web/dist/.gitkeep
