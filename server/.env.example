PORT=8080
ENV=development
DATABASE_URL=postgres://ota:ota@localhost:5433/ota?sslmode=disable

# Asset storage: Cloudflare R2 (S3-compatible). Required, the API won't start without it.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public URL of the bucket's "assets/" prefix (r2.dev or custom domain), no trailing slash.
ASSET_BASE_URL=https://<public-bucket-host>/assets
